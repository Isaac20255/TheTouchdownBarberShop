@model IEnumerable<TheTouchdownBarberShop.Application.DTO.SucursalDTO>

@{
    ViewData["Title"] = ViewBag.Titulo ?? "Catálogo de Sucursales";
}

<div class="rounded-3 py-4 px-4 my-4 shadow-lg position-relative overflow-hidden"
     style="background: linear-gradient(135deg, rgba(13, 110, 253, 0.9), rgba(33, 37, 41, 0.95)); border-bottom: 4px solid #dc3545;">
    <div class="container text-white py-2 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <span class="badge bg-danger text-uppercase px-3 py-2 mb-2 shadow-sm">Mantenimiento</span>
            <h1 class="display-6 fw-bold text-white mb-0">
                <i class="bi bi-building me-2"></i>@ViewData["Title"]
            </h1>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-danger fw-bold shadow">
                <i class="bi bi-plus-lg me-1"></i>Nueva Sucursal
            </a>
        </div>
    </div>
</div>

@if (ViewBag.NotificationMessage != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@ViewBag.NotificationMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 bg-secondary bg-opacity-10 border-0 shadow-sm text-center overflow-hidden"
                     style="border-top: 3px solid #0d6efd !important;">

                    <div class="bg-white py-3 border-bottom position-relative">
                        <span class="position-absolute top-0 end-0 bg-danger text-white px-2 py-1 m-2 rounded fw-bold shadow-sm" style="font-size: 0.75rem;">
                            #@item.IdSucursal
                        </span>
                        <span class="badge bg-primary text-uppercase px-2 py-1 mb-1" style="font-size: 0.7rem;">Sucursal</span>
                        <h5 class="card-title text-dark fw-bold mb-0 px-3 text-truncate">@item.Nombre</h5>
                        @if (item.EstaAbierta)
                        {
                            <span class="badge bg-success mt-1">Abierta</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary mt-1">Cerrada</span>
                        }
                    </div>

                    <div class="card-body d-flex flex-column text-start">
                        <p class="card-text text-muted small mb-1">
                            <i class="bi bi-geo-alt-fill me-1 text-danger"></i><strong>Dirección:</strong> @item.Direccion
                        </p>
                        <p class="card-text text-muted small mb-1">
                            <i class="bi bi-telephone-fill me-1 text-primary"></i><strong>Teléfono:</strong> @item.Telefono
                        </p>
                        <p class="card-text text-muted small mb-1">
                            <i class="bi bi-envelope-fill me-1 text-success"></i><strong>Correo:</strong> @item.Correo
                        </p>
                        <p class="card-text text-muted small mb-0 mt-2">
                            <i class="bi bi-person-badge-fill me-1"></i><strong>Admin:</strong> @(string.IsNullOrEmpty(item.AdministradorNombre) ? "Sin asignar" : item.AdministradorNombre)
                        </p>
                    </div>

                    <div class="card-footer bg-transparent border-0 p-2 pb-3">
                        <div class="d-flex justify-content-between gap-1 mb-1">
                            <a asp-action="Edit" asp-route-id="@item.IdSucursal" class="btn btn-sm btn-outline-secondary flex-fill" title="Editar">
                                <i class="bi bi-pencil-fill me-1"></i>Editar
                            </a>
                            @if (item.EstaAbierta)
                            {
                                <a asp-action="Details" asp-route-id="@item.IdSucursal" class="btn btn-sm btn-outline-primary flex-fill" title="Detalles">
                                    <i class="bi bi-eye-fill me-1"></i>Ver
                                </a>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary flex-fill" disabled title="La sucursal está cerrada">
                                    <i class="bi bi-lock-fill me-1"></i>Ver
                                </button>
                            }
                            <a asp-action="Delete" asp-route-id="@item.IdSucursal" class="btn btn-sm btn-outline-danger flex-fill" title="Eliminar">
                                <i class="bi bi-trash-fill me-1"></i>Borrar
                            </a>
                        </div>
                        <a asp-controller="HorarioSucursal" asp-action="Index" asp-route-idSucursal="@item.IdSucursal" class="btn btn-sm btn-outline-dark w-100 fw-semibold shadow-sm py-2 rounded-pill mt-1 transition-all">
                            <i class="bi bi-clock-fill me-1 text-primary"></i>Horarios
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="card bg-secondary bg-opacity-10 border-0 shadow-sm text-center p-5"
                 style="border-top: 3px solid #dc3545 !important;">
                <i class="bi bi-building-slash fs-1 text-danger mb-3"></i>
                <h4 class="text-dark fw-bold">No hay sucursales registradas</h4>
                <p class="text-muted mb-4">Aún no se han agregado sucursales a la lista.</p>
                <div>
                    <a asp-action="Create" class="btn btn-danger fw-bold">
                        <i class="bi bi-plus-lg me-1"></i>Agregar Primera Sucursal
                    </a>
                </div>
            </div>
        </div>
    }
</div>