@model TheTouchdownBarberShop.Application.DTO.SucursalDTO

@{
    ViewData["Title"] = $"Sucursal #{Model.IdSucursal}";
}

<!-- Header principal -->
<div class="rounded-3 py-4 px-4 my-4 shadow-lg position-relative overflow-hidden"
     style="background: linear-gradient(135deg, rgba(13, 110, 253, 0.9), rgba(33, 37, 41, 0.95)); border-bottom: 4px solid #dc3545;">
    <div class="container text-white py-2 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <span class="badge bg-danger text-uppercase px-3 py-2 mb-2 shadow-sm">Detalle</span>
            <h1 class="display-6 fw-bold text-white mb-0">
                <i class="bi bi-shop me-2"></i>@ViewData["Title"]
            </h1>
        </div>
        <a asp-action="Index" class="btn btn-outline-light shadow">
            <i class="bi bi-arrow-left me-1"></i>Volver al listado
        </a>
    </div>
</div>

<!-- Datos generales -->
<div class="card bg-secondary bg-opacity-10 border-0 shadow-sm mb-4" style="border-top: 3px solid #0d6efd !important;">
    <div class="card-body">
        <h5 class="fw-bold text-dark mb-3">Datos generales</h5>
        <div class="row g-3">
            <div class="col-md-6">
                <small class="text-muted d-block">Nombre</small>
                <span class="fw-bold">@Model.Nombre</span>
            </div>
            <div class="col-md-6">
                <small class="text-muted d-block">Administrador</small>
                <span class="fw-bold">@(string.IsNullOrWhiteSpace(Model.AdministradorNombre) ? "Sin asignar" : Model.AdministradorNombre)</span>
            </div>
        </div>
    </div>
</div>

<!-- Contacto y ubicación -->
<div class="card bg-secondary bg-opacity-10 border-0 shadow-sm mb-5" style="border-top: 3px solid #dc3545 !important;">
    <div class="card-body">
        <h5 class="fw-bold text-dark mb-3">Contacto y ubicación</h5>
        <div class="row g-3">
            <div class="col-md-4">
                <small class="text-muted d-block">Teléfono</small>
                <span class="fw-bold">@Model.Telefono</span>
            </div>
            <div class="col-md-4">
                <small class="text-muted d-block">Correo</small>
                <span class="fw-bold">@Model.Correo</span>
            </div>
            <div class="col-md-4">
                <small class="text-muted d-block">Dirección</small>
                <span class="fw-bold">@Model.Direccion</span>
            </div>
        </div>
    </div>
</div>