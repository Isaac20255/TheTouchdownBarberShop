@model TheTouchdownBarberShop.Application.DTO.SucursalDTO

@{
    ViewData["Title"] = "Eliminar Sucursal";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-3 border-top border-danger border-4">
                <div class="card-header bg-white text-danger py-3">
                    <h3 class="mb-0 fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Eliminar Sucursal</h3>
                </div>
                <div class="card-body p-4">
                    <h5 class="text-danger mb-3">¿Está seguro de que desea eliminar esta sucursal?</h5>

                    <dl class="row">
                        <dt class="col-sm-3 fw-bold">@Html.DisplayNameFor(model => model.Nombre)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.Nombre)</dd>

                        <dt class="col-sm-3 fw-bold">@Html.DisplayNameFor(model => model.Direccion)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.Direccion)</dd>

                        <dt class="col-sm-3 fw-bold">@Html.DisplayNameFor(model => model.Telefono)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.Telefono)</dd>

                        <dt class="col-sm-3 fw-bold">@Html.DisplayNameFor(model => model.Correo)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.Correo)</dd>

                        <dt class="col-sm-3 fw-bold">Administrador</dt>
                        <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.AdministradorNombre) ? "Sin asignar" : Model.AdministradorNombre)</dd>
                    </dl>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="IdSucursal" />
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Volver
                            </a>
                            <button type="submit" class="btn btn-danger fw-bold">
                                <i class="bi bi-trash-fill me-1"></i>Eliminar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>