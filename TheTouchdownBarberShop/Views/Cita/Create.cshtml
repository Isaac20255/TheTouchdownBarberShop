@model TheTouchdownBarberShop.Application.DTOs.CitaDTO

@{
    ViewData["Title"] = "Registrar cita";
}

<div class="rounded-3 py-4 px-4 my-4 shadow-lg"
     style="background: linear-gradient(135deg, rgba(13, 110, 253, 0.9), rgba(33, 37, 41, 0.95)); border-bottom: 4px solid #dc3545;">
    <div class="container text-white py-2">
        <h1 class="display-6 fw-bold text-white mb-0">
            <i class="bi bi-plus-circle me-2"></i>@ViewData["Title"]
        </h1>
    </div>
</div>

<form asp-action="Create" asp-route-idEncargado="@ViewBag.IdEncargado" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <partial name="_CitaForm" model="Model" />

    <div class="d-flex justify-content-between mt-4 mb-5">
        <a asp-action="Index" asp-route-idEncargado="@ViewBag.IdEncargado" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
        <button type="submit" class="btn btn-danger fw-bold">
            <i class="bi bi-check-circle me-1"></i>Registrar cita
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}