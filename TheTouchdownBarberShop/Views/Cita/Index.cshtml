@model IEnumerable<TheTouchdownBarberShop.Application.DTOs.CitaDTO>

@{
    ViewData["Title"] = "Historial de Reservas";
    var sucursal = Model?.FirstOrDefault()?.Sucursal;

    var encargados = ViewBag.Encargados as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                     ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();

    // Clase del badge según el estado
    string ClaseEstado(string estado) => estado switch
    {
        "Pendiente" => "bg-warning text-dark",
        "Confirmada" => "bg-primary",
        "Completada" => "bg-success",
        "Cancelada" => "bg-danger",
        _ => "bg-secondary"
    };

    // Color del borde superior de la tarjeta según el estado
    string ColorBorde(string estado) => estado switch
    {
        "Pendiente" => "#ffc107",
        "Confirmada" => "#0d6efd",
        "Completada" => "#198754",
        "Cancelada" => "#dc3545",
        _ => "#6c757d"
    };
}

<!-- Header principal -->
<div class="rounded-3 py-4 px-4 my-4 shadow-lg position-relative overflow-hidden"
     style="background: linear-gradient(135deg, rgba(13, 110, 253, 0.9), rgba(33, 37, 41, 0.95)); border-bottom: 4px solid #dc3545;">
    <div class="container text-white py-2 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <span class="badge bg-danger text-uppercase px-3 py-2 mb-2 shadow-sm">Encargado</span>
            <h1 class="display-6 fw-bold text-white mb-0">
                <i class="bi bi-calendar-check me-2"></i>@ViewData["Title"]
            </h1>
            @if (sucursal != null)
            {
                <p class="mb-0 mt-2 text-white-50"><i class="bi bi-shop me-1"></i>@sucursal</p>
            }
        </div>

        <!-- Filtro por encargado -->
        @if (encargados.Any())
        {
            <form asp-action="Index" method="get" class="rounded-3 p-3 shadow-sm"
                  style="background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.25); backdrop-filter: blur(4px); min-width: 320px;">
                <label for="idEncargado" class="d-block small text-uppercase fw-bold text-white-50 mb-2"
                       style="letter-spacing: 0.05em;">
                    Filtrar por encargado
                </label>
                <div class="input-group">
                    <span class="input-group-text bg-danger border-danger text-white">
                        <i class="bi bi-person-badge"></i>
                    </span>
                    <select id="idEncargado" name="idEncargado" class="form-select border-0 fw-semibold"
                            onchange="this.form.submit()">
                        @foreach (var e in encargados)
                        {
                            <option value="@e.Value" selected="@e.Selected">@e.Text</option>
                        }
                    </select>
                </div>
            </form>
        }
        else
        {
            <span class="badge bg-warning text-dark px-3 py-2">No hay encargados registrados en la BD</span>
        }
    </div>
</div>

<!-- Listado en Cards -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 bg-secondary bg-opacity-10 border-0 shadow-sm text-center overflow-hidden"
                     style="border-top: 3px solid @ColorBorde(item.Estado) !important;">

                    <!-- Contenido: 4 campos -->
                    <div class="card-body d-flex flex-column">
                        <p class="text-muted mb-2">
                            <i class="bi bi-calendar-event me-1"></i>@item.FechaHora.ToString("dd/MM/yyyy HH:mm")
                        </p>
                        <h5 class="card-title text-dark fw-bold mb-2">@item.NombreCliente</h5>
                        <p class="card-text text-muted flex-grow-1">
                            <i class="bi bi-scissors me-1"></i>@item.NombreBarbero
                        </p>
                        <div class="mb-2">
                            <span class="badge px-3 py-2 @ClaseEstado(item.Estado)">@item.Estado</span>
                        </div>
                    </div>

                    <!-- Botón de acción -->
                    <div class="card-footer bg-transparent border-0 p-2 pb-3">
                        <a asp-action="Details" asp-route-id="@item.IdCita" asp-route-idEncargado="@ViewBag.IdEncargado"
                           class="btn btn-sm btn-outline-primary w-100" title="Detalles">
                            <i class="bi bi-eye-fill me-1"></i>Ver detalle
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="card bg-secondary bg-opacity-10 border-0 shadow-sm text-center p-5"
                 style="border-top: 3px solid #dc3545 !important;">
                <i class="bi bi-inbox fs-1 text-danger mb-3"></i>
                <h4 class="text-dark fw-bold">No hay reservas registradas</h4>
                <p class="text-muted mb-0">Aún no hay reservas en esta sucursal.</p>
            </div>
        </div>
    }
</div>