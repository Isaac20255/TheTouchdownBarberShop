@model IEnumerable<TheTouchdownBarberShop.Application.DTOs.CitaDTO>

@{
    var estaAutenticado = User.Identity?.IsAuthenticated == true;
    var esStaff = estaAutenticado && (User.IsInRole("Administrador") || User.IsInRole("Encargado"));

    ViewData["Title"] = esStaff ? "Historial de Citas" : "Mis Citas";
    var sucursal = esStaff ? Model?.FirstOrDefault()?.Sucursal : null;

    var encargados = ViewBag.Encargados as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                     ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();

    string ClaseEstado(string estado) => estado switch
    {
        "Pendiente" => "bg-warning text-dark",
        "Confirmada" => "bg-primary",
        "Completada" => "bg-success",
        "Cancelada" => "bg-danger",
        _ => "bg-secondary"
    };

    string ColorBorde(string estado) => estado switch
    {
        "Pendiente" => "#ffc107",
        "Confirmada" => "#0d6efd",
        "Completada" => "#198754",
        "Cancelada" => "#dc3545",
        _ => "#6c757d"
    };
}

<!-- Header principal -->
<div class="rounded-3 py-4 px-4 my-4 shadow-lg position-relative overflow-hidden"
     style="background: linear-gradient(135deg, rgba(13, 110, 253, 0.9), rgba(33, 37, 41, 0.95)); border-bottom: 4px solid #dc3545;">
    <div class="container text-white py-2 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            @if (esStaff)
            {
                <span class="badge bg-danger text-uppercase px-3 py-2 mb-2 shadow-sm">Encargado</span>
            }
            <h1 class="display-6 fw-bold text-white mb-0">
                <i class="bi bi-calendar-check me-2"></i>@ViewData["Title"]
            </h1>
            <p id="subtituloSucursal" class="mb-0 mt-2 text-white-50">
                @if (!string.IsNullOrWhiteSpace(sucursal))
                {
                    <i class="bi bi-shop me-1"></i>
                    @sucursal
                }
            </p>
        </div>

        @if (esStaff)
        {
            @if (encargados.Any())
            {
                <div class="rounded-3 p-3 shadow-sm"
                     style="background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.25); backdrop-filter: blur(4px); min-width: 320px;">
                    <label for="idEncargado" class="d-block small text-uppercase fw-bold text-white-50 mb-2"
                           style="letter-spacing: 0.05em;">
                        Encargado / Sucursal
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-danger border-danger text-white">
                            <i class="bi bi-person-badge"></i>
                        </span>
                        <select id="idEncargado" name="idEncargado" class="form-select border-0 fw-semibold">
                            @foreach (var e in encargados)
                            {
                                <option value="@e.Value" selected="@e.Selected">@e.Text</option>
                            }
                        </select>
                    </div>
                </div>
            }
            else
            {
                <span class="badge bg-warning text-dark px-3 py-2">No hay encargados registrados en la BD</span>
            }
        }
    </div>
</div>

@if (!estaAutenticado)
{
    <div class="card bg-secondary bg-opacity-10 border-0 shadow-sm text-center p-5 mb-5"
         style="border-top: 3px solid #0d6efd !important;">
        <i class="bi bi-lock fs-1 text-primary mb-3"></i>
        <h4 class="text-dark fw-bold">Inicia sesión para ver tus citas</h4>
        <p class="text-muted mb-4">Debes iniciar sesión con tu cuenta para consultar tus citas o gestionar la agenda.</p>
        <div>
            <a asp-controller="Auth" asp-action="Login" class="btn btn-primary fw-bold">
                <i class="bi bi-box-arrow-in-right me-1"></i>Iniciar sesión
            </a>
        </div>
    </div>
}
else
{
    @if (esStaff)
    {
        <!-- Filtros automáticos por cliente y/o fecha sin recargar página -->
        <div class="card bg-secondary bg-opacity-10 border-0 shadow-sm mb-4" style="border-top: 3px solid #0d6efd !important;">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label for="filtroCliente" class="form-label fw-semibold text-dark">Cliente</label>
                        <input type="text" id="filtroCliente" class="form-control" placeholder="Escribe el nombre del cliente..." autocomplete="off" />
                    </div>
                    <div class="col-md-4">
                        <label for="filtroFecha" class="form-label fw-semibold text-dark">Fecha</label>
                        <input type="date" id="filtroFecha" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <button type="button" id="btnLimpiarFiltros" class="btn btn-outline-secondary w-100">
                            <i class="bi bi-x-circle me-1"></i>Limpiar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Listado en Cards -->
    <div id="contenedorCitas" class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 bg-secondary bg-opacity-10 border-0 shadow-sm text-center overflow-hidden"
                         style="border-top: 3px solid @ColorBorde(item.Estado) !important;">

                        <div class="card-body d-flex flex-column">
                            <p class="text-muted mb-2">
                                <i class="bi bi-calendar-event me-1"></i>@item.FechaHora.ToString("dd/MM/yyyy HH:mm")
                            </p>
                            <h5 class="card-title text-dark fw-bold mb-2">@item.NombreCliente</h5>
                            <p class="card-text text-muted flex-grow-1">
                                <i class="bi bi-scissors me-1"></i>@item.NombreBarbero
                            </p>
                            <div class="mb-2">
                                <span class="badge px-3 py-2 @ClaseEstado(item.Estado)">@item.Estado</span>
                            </div>
                        </div>

                        @if (esStaff)
                        {
                            <div class="card-footer bg-transparent border-0 p-2 pb-3">
                                <a asp-action="Details" asp-route-id="@item.IdCita" asp-route-idEncargado="@ViewBag.IdEncargado"
                                   class="btn btn-sm btn-outline-primary w-100" title="Detalles">
                                    <i class="bi bi-eye-fill me-1"></i>Ver detalle
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="card bg-secondary bg-opacity-10 border-0 shadow-sm text-center p-5"
                     style="border-top: 3px solid #dc3545 !important;">
                    <i class="bi bi-inbox fs-1 text-danger mb-3"></i>
                    <h4 class="text-dark fw-bold">
                        @(esStaff ? "No hay reservas registradas" : "No tienes citas registradas")
                    </h4>
                    <p class="text-muted mb-0">
                        @(esStaff ? "Aún no hay reservas en esta sucursal." : "Aún no tienes citas asociadas a tu cuenta.")
                    </p>
                </div>
            </div>
        }
    </div>
}

@if (esStaff)
{
    <script>
        (function () {
            const selectEncargado = document.getElementById("idEncargado");
            const inputCliente = document.getElementById("filtroCliente");
            const inputFecha = document.getElementById("filtroFecha");
            const btnLimpiar = document.getElementById("btnLimpiarFiltros");
            const contenedor = document.getElementById("contenedorCitas");
            const subtituloSucursal = document.getElementById("subtituloSucursal");

            if (!inputCliente || !inputFecha || !contenedor) return;

            let temporizadorBusqueda = null;

            const estilosEstado = {
                "Pendiente": { badge: "bg-warning text-dark", borde: "#ffc107" },
                "Confirmada": { badge: "bg-primary", borde: "#0d6efd" },
                "Completada": { badge: "bg-success", borde: "#198754" },
                "Cancelada": { badge: "bg-danger", borde: "#dc3545" }
            };

            function obtenerEstilo(estado) {
                return estilosEstado[estado] || { badge: "bg-secondary", borde: "#6c757d" };
            }

            function escaparHtml(texto) {
                const div = document.createElement("div");
                div.textContent = texto ?? "";
                return div.innerHTML;
            }

            function renderizarCitas(citas) {
                const idEnc = selectEncargado ? selectEncargado.value : "";

                if (!Array.isArray(citas) || citas.length === 0) {
                    contenedor.innerHTML = `
                        <div class="col-12">
                            <div class="card bg-secondary bg-opacity-10 border-0 shadow-sm text-center p-5"
                                 style="border-top: 3px solid #dc3545 !important;">
                                <i class="bi bi-inbox fs-1 text-danger mb-3"></i>
                                <h4 class="text-dark fw-bold">Sin resultados</h4>
                                <p class="text-muted mb-0">No se encontraron citas con los filtros indicados.</p>
                            </div>
                        </div>`;
                    return;
                }

                if (subtituloSucursal && citas[0].sucursal) {
                    subtituloSucursal.innerHTML = `<i class="bi bi-shop me-1"></i>${escaparHtml(citas[0].sucursal)}`;
                }

                contenedor.innerHTML = citas.map(cita => {
                    const estilo = obtenerEstilo(cita.estado);
                    const urlDetalle = idEnc
                        ? `/Cita/Details/${cita.idCita}?idEncargado=${encodeURIComponent(idEnc)}`
                        : `/Cita/Details/${cita.idCita}`;

                    return `
                        <div class="col">
                            <div class="card h-100 bg-secondary bg-opacity-10 border-0 shadow-sm text-center overflow-hidden"
                                 style="border-top: 3px solid ${estilo.borde} !important;">
                                <div class="card-body d-flex flex-column">
                                    <p class="text-muted mb-2">
                                        <i class="bi bi-calendar-event me-1"></i>${escaparHtml(cita.fechaHora)}
                                    </p>
                                    <h5 class="card-title text-dark fw-bold mb-2">${escaparHtml(cita.nombreCliente)}</h5>
                                    <p class="card-text text-muted flex-grow-1">
                                        <i class="bi bi-scissors me-1"></i>${escaparHtml(cita.nombreBarbero)}
                                    </p>
                                    <div class="mb-2">
                                        <span class="badge px-3 py-2 ${estilo.badge}">${escaparHtml(cita.estado)}</span>
                                    </div>
                                </div>
                                <div class="card-footer bg-transparent border-0 p-2 pb-3">
                                    <a href="${urlDetalle}"
                                       class="btn btn-sm btn-outline-primary w-100" title="Detalles">
                                        <i class="bi bi-eye-fill me-1"></i>Ver detalle
                                    </a>
                                </div>
                            </div>
                        </div>`;
                }).join("");
            }

            async function aplicarFiltros() {
                const params = new URLSearchParams();
                const idEnc = selectEncargado ? selectEncargado.value : "";
                const clienteVal = inputCliente.value.trim();
                const fechaVal = inputFecha.value;

                if (idEnc) params.append("idEncargado", idEnc);
                if (clienteVal) params.append("cliente", clienteVal);
                if (fechaVal) params.append("fecha", fechaVal);

                const url = `/Cita/Filtrar${params.toString() ? "?" + params.toString() : ""}`;
                const response = await fetch(url, { headers: { "X-Requested-With": "XMLHttpRequest" } });
                if (!response.ok) return;

                const data = await response.json();
                renderizarCitas(data);
            }

            function programarFiltro(delayMs = 200) {
                clearTimeout(temporizadorBusqueda);
                temporizadorBusqueda = setTimeout(aplicarFiltros, delayMs);
            }

            if (selectEncargado) {
                selectEncargado.addEventListener("change", aplicarFiltros);
            }

            inputCliente.addEventListener("input", () => programarFiltro(200));
            inputCliente.addEventListener("keydown", (e) => {
                if (e.key === "Enter") {
                    e.preventDefault();
                    clearTimeout(temporizadorBusqueda);
                    aplicarFiltros();
                }
            });

            inputFecha.addEventListener("change", aplicarFiltros);
            inputFecha.addEventListener("input", aplicarFiltros);

            if (btnLimpiar) {
                btnLimpiar.addEventListener("click", () => {
                    clearTimeout(temporizadorBusqueda);
                    inputCliente.value = "";
                    inputFecha.value = "";
                    aplicarFiltros();
                });
            }
        })();
    </script>
}