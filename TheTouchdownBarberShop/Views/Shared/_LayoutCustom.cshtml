<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - The Touchdown Barber Shop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TheTouchdownBarberShop.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!--SweetAlert-->
    <link rel="stylesheet" href="~/css/sweetalert2.min.css" asp-append-version="true" />
</head>
<body>
    <div class="container-fluid">
        <div class="row flex-nowrap">
            <!-- Sidebar con fondo gris oscuro -->
            <div class="col-auto col-md-3 col-xl-2 px-sm-2 px-0 bg-dark border-end border-secondary">
                <div class="d-flex flex-column align-items-center align-items-sm-start px-3 pt-3 text-white min-vh-100">

                    <!-- Logo con ruta dinámica de Razor (~) -->
                    <a href="@Url.Action("Index", "Home")" class="d-flex flex-column align-items-center pb-3 mb-md-0 me-md-auto text-white text-decoration-none w-100 text-center">
                        <img src="~/images/TheTouchdownBarberShopLogo.jpeg" alt="The Touchdown Barber Shop Logo" class="img-fluid rounded-circle shadow mb-2" style="max-width: 160px; border: 3px solid #dc3545;" />
                        <span class="fs-6 d-none d-sm-inline fw-bold text-white">The Touchdown Barber Shop</span>
                    </a>

                    <hr class="text-secondary w-100 my-2">

                    <ul class="nav nav-pills flex-column mb-sm-auto mb-0 align-items-center align-items-sm-start w-100" id="menu">
                        <li>
                            <a href="#submenuMantenimiento" data-bs-toggle="collapse" class="nav-link text-white px-0 align-middle">
                                <i class="fs-4 bi-wrench text-white"></i> <span class="ms-1 d-none d-sm-inline text-white fw-bold">Mantenimientos</span>
                            </a>
                            <ul class="collapse show nav flex-column ms-3" id="submenuMantenimiento" data-bs-parent="#menu">
                                <li>
                                    <a asp-controller="Producto" asp-action="Index" class="nav-link text-white px-0"><span class="d-none d-sm-inline"></span> Productos </a>
                                </li>
                                <li>
                                    <a asp-controller="Servicio" asp-action="Index" class="nav-link text-white px-0"><span class="d-none d-sm-inline"></span> Servicios </a>
                                </li>
                            </ul>
                        </li>
                        <li>
                            <a href="#submenuProcesos" data-bs-toggle="collapse" class="nav-link text-white px-0 align-middle">
                                <i class="fs-4 bi-gear-fill text-white"></i> <span class="ms-1 d-none d-sm-inline text-white fw-bold">Procesos</span>
                            </a>
                            <ul class="collapse show nav flex-column ms-3" id="submenuProcesos" data-bs-parent="#menu">
                                <li class="w-100">
                                    <a asp-controller="Cita" asp-action="Index" class="nav-link text-white px-0"><span class="d-none d-sm-inline"></span> Citas </a>
                                </li>
                                <li class="w-100">
                                    <a asp-controller="Factura" asp-action="Index" class="nav-link text-white px-0"><span class="d-none d-sm-inline"></span> Facturas </a>
                                </li>
                            </ul>
                        </li>
                        <li>
                            <a href="#submenuSeguridad" data-bs-toggle="collapse" class="nav-link text-white px-0 align-middle">
                                <i class="fs-4 bi-people text-white"></i> <span class="ms-1 d-none d-sm-inline text-white fw-bold">Seguridad</span>
                            </a>
                            <ul class="collapse show nav flex-column ms-3" id="submenuSeguridad" data-bs-parent="#menu">
                                <li class="w-100">
                                    <a href="@Url.Action("Index", "Usuario")" class="nav-link text-white px-0"><span class="d-none d-sm-inline"></span> Usuarios </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                    <hr class="text-secondary w-100">
                    <div class="dropdown pb-4">
                        <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" id="dropdownUser1" data-bs-toggle="dropdown" aria-expanded="false">
                            <img class="rounded-circle mx-2 mt-1" src="~/images/profile.png" alt="Usuario" width="32" height="32" />
                            <span class="d-none d-sm-inline mx-1 text-white">Usuario</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark text-small shadow" aria-labelledby="dropdownUser1">
                            <li><a class="dropdown-item text-white" href="#">Salir</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col py-3">
                <div class="container">
                    <main role="main" class="pb-3">
                        @RenderBody()
                    </main>
                </div>
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!--SweetAlert-->
    <script src="~/js/sweetalert2.all.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @if (ViewBag.NotificationMessage != null)
    {
        <script>
            @Html.Raw(ViewBag.NotificationMessage);
        </script>
    }
</body>
</html>