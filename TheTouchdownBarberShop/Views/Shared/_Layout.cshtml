<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - The Touchdown Barber Shop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TheTouchdownBarberShop.Web.styles.css" asp-append-version="true" />
    <style>
        .wrapper {
            display: flex;
            width: 100%;
            align-items: stretch;
            min-height: 100vh;
        }

        #sidebar {
            min-width: 250px;
            max-width: 250px;
            position: sticky;
            top: 0;
            height: 100vh;
            overflow-y: auto;
            transition: all 0.3s;
        }

            #sidebar.active {
                margin-left: -250px;
            }

        #content {
            width: 100%;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        main {
            flex: 1;
        }

        .btn-toggle-sidebar {
            background-color: #232d39;
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 6px 12px;
            transition: all 0.2s ease;
        }

            .btn-toggle-sidebar:hover {
                background-color: #fb5849;
                color: #fff;
            }

        @@media (max-width: 768px) {
            #sidebar {
                margin-left: -250px;
                position: fixed;
                z-index: 1000;
            }

                #sidebar.active {
                    margin-left: 0;
                }
        }
    </style>
</head>
<body>
    <div class="wrapper">
        <!-- Sidebar -->
        <nav id="sidebar" class="bg-dark text-white p-3">
            <div class="sidebar-header pb-3 mb-3 border-bottom border-secondary">
                <h3 class="h5 fw-bold text-danger m-0">
                    <i class="bi bi-scissors me-2"></i>Touchdown Barber
                </h3>
            </div>

            <ul class="list-unstyled components">
                <li class="mb-2">
                    <a asp-controller="Home" asp-action="Index" class="nav-link text-white p-2 rounded">
                        <i class="bi bi-house-door me-2"></i> Inicio
                    </a>
                </li>
                <li class="mb-2">
                    <a asp-controller="Servicio" asp-action="Index" class="nav-link text-white p-2 rounded">
                        <i class="bi bi-scissors me-2"></i> Servicios
                    </a>
                </li>
                <li class="mb-2">
                    <a asp-controller="Producto" asp-action="Index" class="nav-link text-white p-2 rounded">
                        <i class="bi bi-bag me-2"></i> Productos
                    </a>
                </li>
                <li class="mb-2">
                    <a asp-controller="Cita" asp-action="Index" class="nav-link text-white p-2 rounded">
                        <i class="bi bi-calendar-check me-2"></i> Citas
                    </a>
                </li>
                <li class="mb-2">
                    <a asp-controller="Sucursal" asp-action="Index" class="nav-link text-white p-2 rounded">
                        <i class="bi bi-shop me-2"></i> Sucursales
                    </a>
                </li>
                <li class="mb-2">
                    <a asp-controller="Usuario" asp-action="Index" class="nav-link text-white p-2 rounded">
                        <i class="bi bi-people me-2"></i> Usuarios
                    </a>
                </li>
                <li class="mb-2">
                    <a asp-controller="Factura" asp-action="Index" class="nav-link text-white p-2 rounded">
                        <i class="bi bi-receipt me-2"></i> Facturas
                    </a>
                </li>
                <li class="mb-2">
                    <a asp-controller="Home" asp-action="Privacy" class="nav-link text-white p-2 rounded">
                        <i class="bi bi-shield-lock me-2"></i> Privacidad
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Page Content -->
        <div id="content" class="w-100">
            <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm px-4">
                <div class="container-fluid">
                    <button type="button" id="sidebarCollapse" class="btn-toggle-sidebar d-flex align-items-center shadow-sm">
                        <i class="bi bi-list fs-5 me-1"></i> <span class="fw-medium small">Menú</span>
                    </button>
                </div>
            </nav>

            <div class="container-fluid p-4">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>

            <footer class="border-top footer text-muted bg-white py-3 px-4 text-center">
                &copy; 2026 - The Touchdown Barber Shop | Desarrollado por <span class="fw-bold text-dark">Isaac Acuña Araya</span> 
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            $('#sidebarCollapse').on('click', function () {
                $('#sidebar').toggleClass('active');
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>