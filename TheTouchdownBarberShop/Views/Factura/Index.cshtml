@model IEnumerable<TheTouchdownBarberShop.Application.DTO.FacturaDTO>

@{
    ViewData["Title"] = ViewBag.Titulo ?? "Historial de Facturación";
}

<!-- Header principal -->
<div class="rounded-3 py-4 px-4 my-4 shadow-lg position-relative overflow-hidden"
     style="background: linear-gradient(135deg, rgba(13, 110, 253, 0.9), rgba(33, 37, 41, 0.95)); border-bottom: 4px solid #dc3545;">
    <div class="container text-white py-2 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <span class="badge bg-danger text-uppercase px-3 py-2 mb-2 shadow-sm">Administrador</span>
            <h1 class="display-6 fw-bold text-white mb-0">
                <i class="bi bi-receipt me-2"></i>@ViewData["Title"]
            </h1>
        </div>
    </div>
</div>

<!-- Listado en Cards -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 bg-secondary bg-opacity-10 border-0 shadow-sm text-center overflow-hidden"
                     style="border-top: 3px solid #0d6efd !important;">

                    <!-- Contenido: 4 campos -->
                    <div class="card-body d-flex flex-column">
                        <p class="text-muted mb-2">
                            <i class="bi bi-calendar-event me-1"></i>@item.FechaEmision.ToString("dd/MM/yyyy HH:mm")
                        </p>
                        <h5 class="card-title text-dark fw-bold mb-2">@item.ClienteNombre</h5>
                        <p class="card-text text-muted flex-grow-1">
                            <i class="bi bi-credit-card me-1"></i>@item.MetodoPagoNombre
                        </p>
                        <div class="mb-2">
                            <span class="fs-5 fw-bold text-primary">₡@item.Total.ToString("N2")</span>
                        </div>
                    </div>

                    <!-- Botón de acción -->
                    <div class="card-footer bg-transparent border-0 p-2 pb-3">
                        <a asp-action="Details" asp-route-id="@item.IdFactura" class="btn btn-sm btn-outline-primary w-100" title="Detalles">
                            <i class="bi bi-eye-fill me-1"></i>Ver detalle
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="card bg-secondary bg-opacity-10 border-0 shadow-sm text-center p-5"
                 style="border-top: 3px solid #dc3545 !important;">
                <i class="bi bi-inbox fs-1 text-danger mb-3"></i>
                <h4 class="text-dark fw-bold">No hay facturas registradas</h4>
                <p class="text-muted mb-0">Aún no se han generado facturas.</p>
            </div>
        </div>
    }
</div>