@model TheTouchdownBarberShop.Application.DTO.FacturaDTO

@{
    var esProforma = Model.IdFactura > 0;
    ViewData["Title"] = esProforma ? "Registrar factura desde proforma" : "Registrar factura";

    var clientes = ViewBag.Clientes as List<(int Id, string Nombre, string Correo)>
                   ?? new List<(int Id, string Nombre, string Correo)>();
    var productos = ViewBag.Productos as List<(int Id, string Nombre, decimal Precio)>
                    ?? new List<(int Id, string Nombre, decimal Precio)>();
    var servicios = ViewBag.Servicios as List<(int Id, string Nombre, decimal Precio)>
                    ?? new List<(int Id, string Nombre, decimal Precio)>();

    var clienteActual = clientes.FirstOrDefault(c => c.Id == Model.IdCliente);
    var nombreClienteMostrado = !string.IsNullOrWhiteSpace(clienteActual.Nombre) ? clienteActual.Nombre : Model.ClienteNombre;
    var correoClienteMostrado = !string.IsNullOrWhiteSpace(clienteActual.Correo) ? clienteActual.Correo : Model.ClienteCorreo;

    var catalogoJson = System.Text.Json.JsonSerializer.Serialize(new
    {
        servicios = servicios.Select(s => new { id = s.Id, nombre = s.Nombre, precio = s.Precio }),
        productos = productos.Select(p => new { id = p.Id, nombre = p.Nombre, precio = p.Precio })
    });

    var lineasJson = System.Text.Json.JsonSerializer.Serialize(
        Model.FacturaServicios
            .Select(s => new { tipo = "S", id = s.IdServicio, cantidad = s.Cantidad, precio = s.PrecioUnitario > 0 ? s.PrecioUnitario : (decimal?)null })
            .Concat(Model.FacturaProductos
                .Select(p => new { tipo = "P", id = p.IdProducto, cantidad = p.Cantidad, precio = p.PrecioUnitario > 0 ? p.PrecioUnitario : (decimal?)null })));

    var porcentaje = Model.PorcentajeImpuesto.ToString(System.Globalization.CultureInfo.InvariantCulture);
}

<div class="rounded-3 py-4 px-4 my-4 shadow-lg"
     style="background: linear-gradient(135deg, rgba(13, 110, 253, 0.9), rgba(33, 37, 41, 0.95)); border-bottom: 4px solid #dc3545;">
    <div class="container text-white py-2">
        <h1 class="display-6 fw-bold text-white mb-0">
            <i class="bi bi-receipt me-2"></i>@ViewData["Title"]
        </h1>
    </div>
</div>

<form asp-action="Registrar" asp-route-idEncargado="@ViewBag.IdEncargado" method="post" id="formFactura">
    <div asp-validation-summary="All" class="alert alert-danger"></div>

    <input type="hidden" asp-for="IdFactura" />

    <!-- Encabezado de la factura -->
    <div class="card bg-secondary bg-opacity-10 border-0 shadow-sm mb-4" style="border-top: 3px solid #0d6efd !important;">
        <div class="card-body">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-card-heading me-2"></i>Encabezado</h5>

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Fecha</label>
                    <input type="text" class="form-control" value="@Model.FechaEmision.ToString("dd/MM/yyyy HH:mm")" readonly tabindex="-1" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Sucursal</label>
                    <input type="text" class="form-control" value="@Model.SucursalNombre" readonly tabindex="-1" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Encargado</label>
                    <input type="text" class="form-control" value="@Model.EncargadoNombre" readonly tabindex="-1" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Cliente</label>
                    @if (esProforma)
                    {
                        <input type="hidden" asp-for="IdCliente" />
                        <input type="text" class="form-control" value="@nombreClienteMostrado" readonly tabindex="-1" />
                    }
                    else
                    {
                        <select asp-for="IdCliente" class="form-select">
                            <option value="0">-- Seleccione un cliente --</option>
                            @foreach (var c in clientes)
                            {
                                <option value="@c.Id" data-correo="@c.Correo" selected="@(c.Id == Model.IdCliente)">@c.Nombre</option>
                            }
                        </select>
                        <span asp-validation-for="IdCliente" class="text-danger"></span>
                    }
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Nombre completo</label>
                    <input type="text" id="clienteNombre" class="form-control" value="@nombreClienteMostrado" readonly tabindex="-1" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Correo</label>
                    <input type="text" id="clienteCorreo" class="form-control" value="@correoClienteMostrado" readonly tabindex="-1" />
                </div>
            </div>
        </div>
    </div>

    <!-- Detalle de la factura -->
    <div class="card bg-secondary bg-opacity-10 border-0 shadow-sm mb-4" style="border-top: 3px solid #dc3545 !important;">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-list-ul me-2"></i>Detalle</h5>
                <button type="button" id="btnAgregarLinea" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-plus-circle me-1"></i>Agregar línea
                </button>
            </div>

            <div id="errorDetalle" class="alert alert-danger d-none"></div>

            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="min-width: 260px;">Producto / Servicio</th>
                            <th class="text-end">Precio</th>
                            <th style="width: 120px;">Cantidad</th>
                            <th class="text-end">Subtotal</th>
                            <th class="text-end">Impuesto (@((Model.PorcentajeImpuesto * 100).ToString("0"))%)</th>
                            <th class="text-end">Total</th>
                            <th style="width: 60px;"></th>
                        </tr>
                    </thead>
                    <tbody id="cuerpoDetalle"></tbody>
                    <tbody>
                        <tr id="filaVacia">
                            <td colspan="7" class="text-center text-muted py-4">
                                Aún no hay líneas. Pulse "Agregar línea" para registrar un producto o servicio.
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="5" class="text-end fw-semibold">Subtotal</td>
                            <td class="text-end" id="totalSubtotal">₡0,00</td>
                            <td></td>
                        </tr>
                        <tr>
                            <td colspan="5" class="text-end fw-semibold">Impuesto</td>
                            <td class="text-end" id="totalImpuesto">₡0,00</td>
                            <td></td>
                        </tr>
                        <tr>
                            <td colspan="5" class="text-end fw-bold fs-5">Total</td>
                            <td class="text-end fw-bold fs-5" id="totalGeneral">₡0,00</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div id="camposDetalle"></div>

    <div class="d-flex justify-content-between mb-5">
        <a asp-action="Index" asp-route-idEncargado="@ViewBag.IdEncargado" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
        <button type="submit" class="btn btn-danger fw-bold">
            <i class="bi bi-check-circle me-1"></i>Registrar factura
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const pct = @Html.Raw(porcentaje);
            const catalogo = @Html.Raw(catalogoJson);
            const lineasIniciales = @Html.Raw(lineasJson);

            const form = document.getElementById("formFactura");
            const cuerpo = document.getElementById("cuerpoDetalle");
            const filaVacia = document.getElementById("filaVacia");
            const errorDetalle = document.getElementById("errorDetalle");
            const camposDetalle = document.getElementById("camposDetalle");
            const selCliente = document.getElementById("IdCliente");

            const precios = {};
            catalogo.servicios.forEach(s => precios["S:" + s.id] = s.precio);
            catalogo.productos.forEach(p => precios["P:" + p.id] = p.precio);

            const moneda = n => "₡" + n.toLocaleString("es-CR", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            const redondear = n => Math.round((n + Number.EPSILON) * 100) / 100;

            function escaparHtml(texto) {
                const div = document.createElement("div");
                div.textContent = texto ?? "";
                return div.innerHTML;
            }

            function opcionesItems(seleccion) {
                const grupo = (etiqueta, tipo, lista) =>
                    `<optgroup label="${etiqueta}">` +
                    lista.map(x =>
                        `<option value="${tipo}:${x.id}" data-precio="${x.precio}" ${seleccion === tipo + ":" + x.id ? "selected" : ""}>${escaparHtml(x.nombre)}</option>`
                    ).join("") +
                    `</optgroup>`;

                return `<option value="">-- Seleccione --</option>` +
                    grupo("Servicios", "S", catalogo.servicios) +
                    grupo("Productos", "P", catalogo.productos);
            }

            function mostrarError(mensaje) {
                errorDetalle.textContent = mensaje;
                errorDetalle.classList.remove("d-none");
            }

            function ocultarError() {
                errorDetalle.classList.add("d-none");
            }

            function agregarFila(linea) {
                const clave = linea ? linea.tipo + ":" + linea.id : "";
                const tr = document.createElement("tr");

                tr.dataset.precio = linea ? (linea.precio ?? precios[clave] ?? 0) : 0;

                tr.innerHTML = `
                    <td><select class="form-select form-select-sm sel-item">${opcionesItems(clave)}</select></td>
                    <td class="text-end celda-precio"></td>
                    <td><input type="text" inputmode="numeric" maxlength="5" autocomplete="off"
                               class="form-control form-control-sm inp-cantidad" value="${linea ? linea.cantidad : 1}" /></td>
                    <td class="text-end celda-subtotal"></td>
                    <td class="text-end celda-impuesto"></td>
                    <td class="text-end celda-total"></td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-outline-danger btn-quitar" title="Quitar línea">
                            <i class="bi bi-trash-fill"></i>
                        </button>
                    </td>`;

                cuerpo.appendChild(tr);
                recalcular();
            }

            function recalcular() {
                let subtotal = 0, impuesto = 0;
                const filas = cuerpo.querySelectorAll("tr");

                filas.forEach(tr => {
                    const precio = parseFloat(tr.dataset.precio) || 0;
                    const cantidad = parseInt(tr.querySelector(".inp-cantidad").value, 10) || 0;
                    const sub = redondear(precio * cantidad);
                    const imp = redondear(sub * pct);

                    tr.querySelector(".celda-precio").textContent = moneda(precio);
                    tr.querySelector(".celda-subtotal").textContent = moneda(sub);
                    tr.querySelector(".celda-impuesto").textContent = moneda(imp);
                    tr.querySelector(".celda-total").textContent = moneda(sub + imp);

                    subtotal += sub;
                    impuesto += imp;
                });

                document.getElementById("totalSubtotal").textContent = moneda(subtotal);
                document.getElementById("totalImpuesto").textContent = moneda(impuesto);
                document.getElementById("totalGeneral").textContent = moneda(subtotal + impuesto);

                filaVacia.style.display = filas.length === 0 ? "" : "none";
            }

            cuerpo.addEventListener("change", e => {
                const tr = e.target.closest("tr");
                if (!tr) return;

                if (e.target.classList.contains("sel-item")) {
                    const opcion = e.target.options[e.target.selectedIndex];
                    tr.dataset.precio = opcion && opcion.dataset.precio ? opcion.dataset.precio : 0;
                    ocultarError();
                    recalcular();
                }

                if (e.target.classList.contains("inp-cantidad")) {
                    if (e.target.value === "") e.target.value = "1";
                    if (parseInt(e.target.value, 10) === 0) {
                        tr.remove();
                    }
                    recalcular();
                }
            });

            cuerpo.addEventListener("input", e => {
                if (e.target.classList.contains("inp-cantidad")) {
                    e.target.value = e.target.value.replace(/\D/g, "");
                    recalcular();
                }
            });

            cuerpo.addEventListener("click", e => {
                const boton = e.target.closest(".btn-quitar");
                if (boton) {
                    boton.closest("tr").remove();
                    recalcular();
                }
            });

            document.getElementById("btnAgregarLinea").addEventListener("click", () => {
                ocultarError();
                agregarFila(null);
            });

            if (selCliente && selCliente.tagName === "SELECT") {
                selCliente.addEventListener("change", () => {
                    const opcion = selCliente.options[selCliente.selectedIndex];
                    const hayCliente = opcion && opcion.value !== "0";
                    document.getElementById("clienteNombre").value = hayCliente ? opcion.text : "";
                    document.getElementById("clienteCorreo").value = hayCliente && opcion.dataset.correo ? opcion.dataset.correo : "";
                });
            }

            form.addEventListener("submit", e => {
                const filas = Array.from(cuerpo.querySelectorAll("tr"));

                if (filas.length === 0) {
                    e.preventDefault();
                    mostrarError("Debe agregar al menos un producto o servicio.");
                    return;
                }

                if (filas.some(tr => !tr.querySelector(".sel-item").value)) {
                    e.preventDefault();
                    mostrarError("Seleccione un producto o servicio en todas las líneas.");
                    return;
                }

                camposDetalle.innerHTML = "";
                let indiceProducto = 0, indiceServicio = 0;

                const agregarCampo = (nombre, valor) => {
                    const input = document.createElement("input");
                    input.type = "hidden";
                    input.name = nombre;
                    input.value = valor;
                    camposDetalle.appendChild(input);
                };

                filas.forEach(tr => {
                    const [tipo, id] = tr.querySelector(".sel-item").value.split(":");
                    const cantidad = parseInt(tr.querySelector(".inp-cantidad").value, 10) || 0;

                    if (tipo === "P") {
                        agregarCampo(`FacturaProductos[${indiceProducto}].IdProducto`, id);
                        agregarCampo(`FacturaProductos[${indiceProducto}].Cantidad`, cantidad);
                        indiceProducto++;
                    } else {
                        agregarCampo(`FacturaServicios[${indiceServicio}].IdServicio`, id);
                        agregarCampo(`FacturaServicios[${indiceServicio}].Cantidad`, cantidad);
                        indiceServicio++;
                    }
                });
            });

            lineasIniciales.forEach(l => agregarFila(l));
            recalcular();
        })();
    </script>
}