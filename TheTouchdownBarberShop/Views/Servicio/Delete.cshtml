@model TheTouchdownBarberShop.Application.DTOs.ServicioDTO

@{
    ViewData["Title"] = "Eliminar Servicio";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 bg-white text-dark" style="border-top: 4px solid #dc3545 !important;">
                <div class="card-body p-4">
                    <h2 class="fw-bold text-dark mb-3"><i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>Eliminar Servicio</h2>
                    <p class="text-muted mb-4">¿Estás seguro de que deseas eliminar este servicio? Esta acción no se puede deshacer.</p>

                    <div class="card bg-light text-dark mb-4 p-3 border-secondary border">
                        <div class="d-flex align-items-center gap-3">
                            @if (!string.IsNullOrEmpty(Model.Imagen))
                            {
                                <img src="~/images/@Model.Imagen" alt="@Model.Nombre" class="rounded border" style="width: 80px; height: 80px; object-fit: cover;" />
                            }
                            <div>
                                <h4 class="mb-1 text-dark fw-bold">@Model.Nombre</h4>
                                <p class="mb-1 text-muted"><strong>Precio:</strong> ₡@Model.Precio.ToString("N2")</p>
                                <p class="mb-0 text-muted"><strong>Duración:</strong> @Model.DuracionMinutos min</p>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="IdServicio" />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-danger fw-bold">Sí, eliminar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>