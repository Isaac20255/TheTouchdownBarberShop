@model TheTouchdownBarberShop.Application.DTOs.ProductoDTO

@{
    ViewData["Title"] = "Crear Producto";
}

<div class="row justify-content-center my-4">
    <div class="col-md-8">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-dark text-white py-3 px-4" style="border-top: 4px solid #0d6efd !important;">
                <h4 class="mb-0 fw-bold">
                    <i class="bi bi-plus-circle-fill text-danger me-2"></i> Nuevo Producto
                </h4>
            </div>
            <div class="card-body p-4 bg-white">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label fw-bold"></label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ej. Cera fijadora deportiva" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="IdCategoriaProducto" class="form-label fw-bold">Categoría</label>
                        <select asp-for="IdCategoriaProducto" class="form-select"
                                asp-items="@(new SelectList(ViewBag.Categorias, "IdCategoriaProducto", "Nombre", Model.IdCategoriaProducto))">
                            <option value="">Seleccione una categoría</option>
                        </select>
                        <span asp-validation-for="IdCategoriaProducto" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label fw-bold"></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Descripción detallada del producto"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Precio" class="form-label fw-bold"></label>
                            <input asp-for="Precio" class="form-control" type="number" step="0.01" placeholder="0.00" />
                            <span asp-validation-for="Precio" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Stock" class="form-label fw-bold"></label>
                            <input asp-for="Stock" class="form-control" type="number" min="0" />
                            <span asp-validation-for="Stock" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Marca" class="form-label fw-bold"></label>
                            <input asp-for="Marca" class="form-control" />
                            <span asp-validation-for="Marca" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Presentacion" class="form-label fw-bold">Presentación</label>
                            <input asp-for="Presentacion" class="form-control" />
                            <span asp-validation-for="Presentacion" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="Activo" class="form-check-input" type="checkbox" />
                        <label asp-for="Activo" class="form-check-label fw-bold"></label>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold">
                            <i class="bi bi-arrow-left me-1"></i> Volver
                        </a>
                        <button type="submit" class="btn btn-danger px-4 fw-bold shadow">
                            <i class="bi bi-check-lg me-1"></i> Guardar Producto
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}