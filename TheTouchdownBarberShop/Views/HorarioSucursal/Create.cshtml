@model TheTouchdownBarberShop.Application.DTOs.HorarioSucursalDTO

@{
    ViewData["Title"] = "Crear Horario";
    var dias = new[] { "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo" };
}

<div class="row justify-content-center my-4">
    <div class="col-md-6">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-dark text-white py-3 px-4" style="border-top: 4px solid #0d6efd !important;">
                <h4 class="mb-0 fw-bold">
                    <i class="bi bi-plus-circle-fill text-danger me-2"></i> Nuevo Horario
                </h4>
            </div>
            <div class="card-body p-4 bg-white">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="IdSucursal" />

                    <div class="mb-3">
                        <label class="form-label fw-bold d-block">Días de la semana</label>
                        @foreach (var dia in dias)
                        {
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" name="DiasSeleccionados" value="@dia" id="dia_@dia"
                                       @(Model.DiasSeleccionados.Contains(dia) ? "checked" : "") />
                                <label class="form-check-label" for="dia_@dia">@dia</label>
                            </div>
                        }
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="HoraInicio" class="form-label fw-bold">Hora de inicio</label>
                            <input asp-for="HoraInicio" class="form-control" type="time" />
                            <span asp-validation-for="HoraInicio" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="HoraFin" class="form-label fw-bold">Hora de fin</label>
                            <input asp-for="HoraFin" class="form-control" type="time" />
                            <span asp-validation-for="HoraFin" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <a asp-action="Index" asp-route-idSucursal="@Model.IdSucursal" class="btn btn-outline-secondary px-4 fw-bold">
                            <i class="bi bi-arrow-left me-1"></i> Volver
                        </a>
                        <button type="submit" class="btn btn-danger px-4 fw-bold shadow">
                            <i class="bi bi-check-lg me-1"></i> Guardar Horario
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}