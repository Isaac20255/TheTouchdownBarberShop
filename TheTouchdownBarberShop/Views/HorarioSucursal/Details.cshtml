@model TheTouchdownBarberShop.Application.DTOs.HorarioSucursalDTO

@{
    ViewData["Title"] = "Detalle del Horario";
}

<div class="row justify-content-center my-4">
    <div class="col-md-6">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-dark text-white py-3 px-4" style="border-top: 4px solid #0d6efd !important;">
                <h4 class="mb-0 fw-bold">
                    <i class="bi bi-info-circle-fill text-primary me-2"></i> Detalle del Horario
                </h4>
            </div>
            <div class="card-body p-4 bg-white">
                <dl class="row mb-4">
                    <dt class="col-sm-5">Sucursal</dt>
                    <dd class="col-sm-7">@Model.SucursalNombre</dd>

                    <dt class="col-sm-5">Día</dt>
                    <dd class="col-sm-7">@Model.DiaSemana</dd>

                    <dt class="col-sm-5">Hora de inicio</dt>
                    <dd class="col-sm-7">@Model.HoraInicio.ToString("HH:mm")</dd>

                    <dt class="col-sm-5">Hora de fin</dt>
                    <dd class="col-sm-7">@Model.HoraFin.ToString("HH:mm")</dd>
                </dl>

                <a asp-action="Index" asp-route-idSucursal="@Model.IdSucursal" class="btn btn-outline-secondary px-4 fw-bold">
                    <i class="bi bi-arrow-left me-1"></i> Volver
                </a>
            </div>
        </div>
    </div>
</div>