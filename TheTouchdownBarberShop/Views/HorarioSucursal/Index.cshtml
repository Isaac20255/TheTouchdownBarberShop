@model IEnumerable<TheTouchdownBarberShop.Application.DTOs.HorarioSucursalDTO>

@{
    ViewData["Title"] = "Horarios de la Sucursal";
    var idSucursal = (int)ViewBag.IdSucursal;
    var dias = new[] { "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo" };
}

<div class="row justify-content-center my-4">
    <div class="col-md-10">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-dark text-white py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2" style="border-top: 4px solid #0d6efd !important;">
                <h4 class="mb-0 fw-bold">
                    <i class="bi bi-clock-fill text-danger me-2"></i> Horarios de la Sucursal
                </h4>
                <div class="d-flex gap-2">
                    <a asp-controller="Sucursal" asp-action="Index" class="btn btn-outline-light fw-bold">
                        <i class="bi bi-arrow-left me-1"></i> Sucursales
                    </a>
                    <a asp-action="Create" asp-route-idSucursal="@idSucursal" class="btn btn-danger fw-bold shadow">
                        <i class="bi bi-plus-lg me-1"></i> Nuevo Horario
                    </a>
                </div>
            </div>
            <div class="card-body p-4 bg-white">
                @if (!Model.Any())
                {
                    <p class="text-muted text-center mb-0">Esta sucursal aún no tiene horarios registrados.</p>
                }
                else
                {
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Día</th>
                                <th>Hora de inicio</th>
                                <th>Hora de fin</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderBy(h => Array.IndexOf(dias, h.DiaSemana)).ThenBy(h => h.HoraInicio))
                            {
                                <tr>
                                    <td>@item.DiaSemana</td>
                                    <td>@item.HoraInicio.ToString("HH:mm")</td>
                                    <td>@item.HoraFin.ToString("HH:mm")</td>
                                    <td class="text-end">
                                        <a asp-action="Details" asp-route-id="@item.IdHorarioSucursal" class="btn btn-outline-primary btn-sm fw-bold">
                                            <i class="bi bi-eye me-1"></i> Detalle
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>